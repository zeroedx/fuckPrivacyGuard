<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.zeroedx.fuckprivacyguard"
    android:versionCode="72"
    android:versionName="2.1.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 11（API 30）起按包名查询其它应用受 Package Visibility 过滤：
        未在此声明的包，getApplicationInfo 会抛 NameNotFoundException，界面会
        把已安装组件误显示成「未安装」。这里按 Catalog 精确列出各系统组件包名，
        不使用 QUERY_ALL_PACKAGES。新增组件时需同步补一项。
    -->
    <queries>
        <package android:name="com.mobiletools.systemhelper" />
        <package android:name="com.miui.guardprovider" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.analytics" />
        <package android:name="com.miui.packageinstaller" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.xiaomi.xmsf" />
        <package android:name="com.miui.systemAdSolution" />
        <package android:name="com.xiaomi.registration" />
        <package android:name="com.miui.dmregservice" />
        <package android:name="com.miui.misightservice" />
        <package android:name="com.xiaomi.trustservice" />
        <package android:name="com.xiaomi.aiasst.vision" />
    </queries>


    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:description="@string/app_desc"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.zeroedx.fuckprivacyguard.XposedService"
            android:exported="true" />

        <!-- 桌面入口只在 alias 上，隐藏图标即禁用它；本 Activity 保留 LSPosed 模块页入口 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
